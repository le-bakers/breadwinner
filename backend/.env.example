# Never use a service-role key in the browser or here; the publishable key suffices.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Exact origins only; use the actual frontend origin (no path, even for GitHub Pages).
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
ALLOWED_HOSTS=localhost,127.0.0.1
OCR_ENGINE=local
CLOUD_OCR_APPROVED=false
GEMINI_DAILY_LIMIT=200
GEMINI_API_KEY=
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=
