      "html": "<section class=\"ds-summary\" aria-label=\"Summary\"><span>Estimated deduction</span><strong>$125.50</strong><div><span>12<small>Receipts</small></span><span>28<small>Gluten-free items</small></span><span>$10.46<small>Average deduction</small></span></div></section>",
      "css": ".ds-summary{font-family:var(--font-body,Inter,sans-serif);font-size:14px;padding:28px 32px;border-radius:16px;color:var(--text,#1F2937);background:linear-gradient(110deg,color-mix(in srgb,var(--primary,#22C55E) 13%,var(--bg,#F8FAF8)),color-mix(in srgb,var(--primary,#22C55E) 4%,var(--bg,#F8FAF8)) 65%,var(--bg,#F8FAF8))}.ds-summary>span{color:var(--workspace-muted,#59665F)}.ds-summary>strong{display:block;margin:8px 0 24px;font-family:var(--font-display,Manrope,sans-serif);font-size:52px;line-height:1.12;font-weight:600;font-variant-numeric:tabular-nums}.ds-summary>div{display:grid;grid-template-columns:repeat(3,minmax(0,180px));gap:16px;font-size:24px}.ds-summary small{display:block;margin-top:6px;font-size:12px;color:var(--workspace-muted,#59665F)}"
    },
    {
      "name": "Receipt review",
